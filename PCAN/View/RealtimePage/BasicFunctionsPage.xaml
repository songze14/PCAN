<Page
    x:Class="PCAN.View.UserPage.BasicFunctionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCAN.View.UserPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:usercontrols="clr-namespace:PCAN.UserControls"
    Title="MainPage"
    d:Background="AliceBlue"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>

        <usercontrols:PCanClientUsercontrol x:Name="PcanClientUsercontrol" Grid.Row="0" />
        <!--<usercontrols:PCanClientCompatibleUsercontrol x:Name="PCanClientCompatibleUsercontrol" Grid.Row="0" />-->
        <DockPanel Grid.Row="1" Background="AliceBlue">
            <StackPanel
                Margin="0,2,0,8"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <TextBox
                    x:Name="idEventGroup"
                    Width="200"
                    Margin="2,2,8,2"
                    ToolTip="16进制(0x111)" />

                <Button x:Name="clearFilter" Margin="2,2,20,2">
                    <md:PackIcon Kind="FilterOff" />
                </Button>

                <Button
                    x:Name="clear"
                    Width="100"
                    HorizontalAlignment="Right"
                    Background="Salmon">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon
                            VerticalAlignment="Stretch"
                            FontSize="40"
                            Kind="Remove" />
                        <TextBlock>清理</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
            <DataGrid
                x:Name="CanMessageDataGrid"
                Grid.Row="2"
                Margin="5"
                AutoGenerateColumns="False"
                IsReadOnly="True">
                <DataGrid.Columns>
                    <!--<DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp}" Width="*"/>-->
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding ID, StringFormat={}{0:X2}}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding MSGTYPE}"
                        Header="类型" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding LEN}"
                        Header="长度" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding DATASTR}"
                        Header="数据" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Count}"
                        Header="次数" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <!--#endregion-->
        <!--#region 数据展示-->

        <!--#endregion-->
    </Grid>
</Page>
