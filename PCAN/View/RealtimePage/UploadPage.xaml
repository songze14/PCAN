<Page
    x:Class="PCAN.View.UserPage.UploadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCAN.View.UserPage"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usercontrols="clr-namespace:PCAN.UserControls"
    Title="UploadPage"
    d:Background="AliceBlue"
    d:DesignHeight="500"
    d:DesignWidth="1600"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <usercontrols:PCanClientUsercontrol x:Name="PcanClientUsercontrol" Grid.Row="0" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition />

            </Grid.RowDefinitions>
            <GroupBox>
                <DockPanel Background="AliceBlue">
                    <DockPanel.Resources>
                        <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUploading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUploading}" Value="False">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Resources>
                    <Label
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="文件路径:" />
                    <TextBox
                        x:Name="FilePathTextBox"
                        Width="400"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsReadOnly="True" />
                    <Button
                        x:Name="BrowseFileButton"
                        Width="75"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="浏览" />
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="MCU" />
                    <TextBox
                        x:Name="MCUTextBox"
                        Width="50"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsReadOnly="True" />
                    <Button
                        x:Name="UploadFileButton"
                        Width="75"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="上传" />
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="重发次数" />
                    <TextBox
                        x:Name="RetryCountTextBox"
                        Width="50"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsReadOnly="True"
                        Text="3" />
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="超时/s" />
                    <TextBox
                        x:Name="TimeoutTextBox"
                        Width="50"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsReadOnly="True"
                        Text="5" />
                    <Label
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="包大小/byte" />
                    <TextBox
                        x:Name="PackSizeTextBox"
                        Width="50"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsReadOnly="True"
                        Text="5" />
                    <CheckBox
                        x:Name="HexUploadCheckBox"
                        Content="HEX升级"
                        IsEnabled="False" />
                    <Button
                        x:Name="RefParmButton"
                        Width="75"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="刷新" />

                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="1">
                <GroupBox.Header>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="上传进度" />
                </GroupBox.Header>

                <DockPanel
                    Margin="0,5,0,5"
                    Background="AliceBlue"
                    SnapsToDevicePixels="False">
                    <DockPanel DockPanel.Dock="Top">
                        <Label Margin="5" Content="上传进度:" />
                        <Label
                            x:Name="UploadProgressLable"
                            Margin="5"
                            VerticalAlignment="Center" />
                        <Label Margin="5" Content="%" />
                        <!--  should disable on 2nd transition...  -->
                        <ProgressBar
                            x:Name="UploadProgressBar"
                            Height="20"
                            Margin="5"
                            materialDesign:TransitionAssist.DisableTransitions="True"
                            Background="AliceBlue" />
                    </DockPanel>
                    <DataGrid
                        x:Name="UploadDataGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        DockPanel.Dock="Bottom">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOver}" Value="True">
                                        <Setter Property="Background" Value="Green" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!--<DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp}" Width="*"/>-->
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Index}"
                                Header="序号" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Size}"
                                Header="大小" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding CRC, StringFormat={}{0:X2}}"
                                Header="CRC" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding SendCount}"
                                Header="重发次数" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding IsOver}"
                                Header="是否完成" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

        </Grid>
    </Grid>
</Page>
