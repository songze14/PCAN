<UserControl
    x:Class="PCAN.UserControls.WpfPlotGLUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCAN.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid x:Name="wpfplotdock">
            <wpf:WpfPlotGL
                Name="WpfPlot1"
                Grid.Row="0"
                MouseMove="WpfPlot1_MouseMove" />
        </Grid>
    </Grid>
</UserControl>
