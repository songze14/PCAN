<UserControl
    x:Class="PCAN.UserControls.UploadSetting.UploadSettingUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCAN.UserControls.UploadSetting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <DockPanel>
        <Label
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Content="重发次数" />
        <TextBox
            x:Name="RetryCountTextBox"
            Width="50"
            Margin="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="3" />
        <Label
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Content="超时/s" />
        <TextBox
            x:Name="TimeoutTextBox"
            Width="50"
            Margin="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="5" />
        <Label
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Content="包大小/byte" />
        <TextBox
            x:Name="PackSizeTextBox"
            Width="50"
            Margin="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="5" />
        <CheckBox x:Name="HexUploadCheckBox" Content="HEX升级" />
        <Button
            x:Name="SaveUploadSettingsButton"
            Width="100"
            Content="保存设置"
            DockPanel.Dock="Left" />
    </DockPanel>
</UserControl>
